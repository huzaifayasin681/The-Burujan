0:{"buildId":"28YV2oq95FWSaf2DAUn6_","rsc":["$","$1","c",{"children":[["$","$L2",null,{"title":"Data Architecture & Privacy Protocol","date":"Last Updated: January 2026","children":[["$","h2",null,{"children":"1. Introduction"}],["$","p",null,{"children":"The Burujan (\"we,\" \"our,\" or \"us\") respects your privacy. Just as we secure the infrastructure of your applications, we secure the personal data you entrust to us. This policy outlines how we handle data collected via our website, TheBurujan.tech."}],["$","h2",null,{"children":"2. Information We Collect"}],["$","p",null,{"children":"We collect information that serves as the \"blueprint\" for our business relationship:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Personal Data:"}]," Name, Email Address, Company Name, and Phone Number (collected via our Contact Form or Booking System)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Technical Data:"}]," IP address, browser type, and interaction data (via Cookies) to optimize our site performance."]}]]}],["$","h2",null,{"children":"3. How We Use Your Data"}],["$","ul",null,{"children":[["$","li",null,{"children":"To architect and deliver the services you request (Web, App, or DevOps)."}],["$","li",null,{"children":"To communicate project milestones via our Point of Contact (Huzaifa Hassan)."}],["$","li",null,{"children":"To improve our internal logic and website performance."}]]}],["$","h2",null,{"children":"4. Storage & Security"}],["$","p",null,{"children":["Your data is stored securely on ",["$","strong",null,{"children":"Hostinger Business servers"}]," using encrypted SQL databases. We employ enterprise-grade security measures to prevent unauthorized access."]}],["$","h2",null,{"children":"5. Third-Party Processors"}],["$","p",null,{"children":"We utilize trusted partners to maintain our infrastructure:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Cloudinary:"}]," For media asset optimization."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Hostinger:"}]," For hosting and database management."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Calendly:"}]," For scheduling consultations."]}]]}],["$","h2",null,{"children":"6. Your Rights"}],["$","p",null,{"children":["You have the right to request a copy of your data or request its deletion (\"The Right to be Forgotten\"). To exercise these rights, contact us at: ",["$","strong",null,{"children":"huzaifa@theburujan.tech"}],"."]}]]}],[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/ccc732e65c9cb016.css","precedence":"next"}],["$","script","script-0",{"src":"/_next/static/chunks/88b7bc47d1951def.js","async":true}]],["$","$L3",null,{"children":["$","$4",null,{"name":"Next.MetadataOutlet","children":"$@5"}]}]]}],"loading":null,"isPartial":false}
